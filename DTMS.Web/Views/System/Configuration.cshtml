@model List<GTMS.Application.Features.System.Configuration.Queries.GetSystemSettings.SystemSettingDto>

@{
    ViewData["Title"] = "System Configuration";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 text-gray-800">System Configuration</h1>
    <button class="btn btn-primary" disabled>
        <i class="bi bi-plus-lg"></i> Add New Setting
    </button>
</div>

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Global Settings</h6>
    </div>
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="alert alert-info text-center">
                <i class="bi bi-info-circle me-2"></i> No system settings defined.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-hover" width="100%" cellspacing="0">
                    <thead class="table-light">
                        <tr>
                            <th>Key</th>
                            <th>Value</th>
                            <th>Description</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var setting in Model)
                        {
                            <tr>
                                <td class="font-monospace fw-bold">@setting.Key</td>
                                <td>@setting.Value</td>
                                <td>@setting.Description</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary" disabled>Edit</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        
        <div class="mt-4 border-top pt-3">
             <h6 class="text-muted fw-bold">Environment Info</h6>
             <ul class="list-group list-group-flush small">
                 <li class="list-group-item d-flex justify-content-between">
                     <span>Server Time</span>
                     <span class="font-monospace">@DateTime.Now.ToString("F")</span>
                 </li>
                 <li class="list-group-item d-flex justify-content-between">
                     <span>OS Version</span>
                     <span class="font-monospace">@System.Environment.OSVersion</span>
                 </li>
                 <li class="list-group-item d-flex justify-content-between">
                     <span>Application Name</span>
                     <span class="font-monospace">Graduation Thesis Management System</span>
                 </li>
             </ul>
        </div>
    </div>
</div>
